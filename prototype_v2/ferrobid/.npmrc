# react-simple-maps@3.0.0 still declares `peer react@"^16.8.0 || 17.x || 18.x"`
# and has had no release since React 19 shipped. The project runs React 19, so
# npm's strict peer resolution aborts `npm ci` with ERESOLVE even though the
# library works fine at runtime (it only needs the classic render/context APIs).
#
# This flag is what the committed package-lock.json was generated with, so it
# keeps local installs and CI resolving identically. Remove it once
# react-simple-maps ships React 19 peers, or once its usage
# (src/guest1/components/WorldChoroplethMap.jsx) is migrated to a maintained
# alternative.
legacy-peer-deps=true
