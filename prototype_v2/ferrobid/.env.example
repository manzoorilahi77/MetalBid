# FerroBid frontend — build-time configuration.
# Copy to .env.local for development, or set as real environment variables in
# whatever builds the production bundle (Vite bakes these in at build time,
# not at runtime — a change here means a rebuild, not a server restart).

# The API's origin. Defaults to http://localhost:4000 when unset, which is
# only ever right for local development. MUST be set to the deployed
# server's public origin before building for production, e.g.
# https://api.ferrobid.example — and that origin must in turn list this
# frontend's own origin in the server's ALLOWED_ORIGINS (see server/.env.example).
VITE_API_URL=http://localhost:4000
