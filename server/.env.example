# FerroBid / MetalBid — development database
# cPanel-hosted MySQL/MariaDB. This file is gitignored — never commit it.

DB_HOST=
DB_PORT=3306
DB_NAME=aspirfxc_ferrobid_dev_db
DB_USER=aspirfxc_ferrobid_dev_user
DB_PASSWORD=

# App
NODE_ENV=development
PORT=4000

# CORS — comma-separated list of frontend origins allowed to call this API.
# Defaults to the Vite dev origins when unset. MUST be set to the deployed
# frontend's origin(s) in production, e.g. https://app.example.com
#ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Authentication — REQUIRED. The server refuses to start without AUTH_SECRET.
#
# It signs every access token. There is deliberately no development default: a
# fallback secret is a fallback that reaches production, and a known signing key
# means anybody can mint a token for any role.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Changing it signs everybody out, which is also how you respond if it leaks.
# ---------------------------------------------------------------------------
AUTH_SECRET=

# Access tokens are short-lived because nothing can revoke one before it
# expires; refresh tokens are long-lived because they can be, and are rotated
# on every use. Both in seconds.
#ACCESS_TTL_SECONDS=900
#REFRESH_TTL_SECONDS=2592000

# The shared password `npm run db:seed-auth` gives every demo account.
# Development only — the script refuses to run with NODE_ENV=production.
#DEV_PASSWORD=FerroBid@Dev2026

# ---------------------------------------------------------------------------
# Scheduler — closes auctions, releases EMD, flags overdue payments.
#
# Runs in-process by default. Set SCHEDULER=off and drive it with
# `POST /api/jobs/tick` from cron when the API runs in more than one process
# and you would rather one machine own the clock.
# ---------------------------------------------------------------------------
#SCHEDULER=on
#SCHEDULER_INTERVAL_MS=15000

# ---------------------------------------------------------------------------
# Uploads — inspection photos, KYC documents, CMS media.
#
# Local disk. Put this OUTSIDE the web root: nothing under it should ever be
# reachable except through GET /api/uploads/:id, which is what applies the
# visibility rules.
# ---------------------------------------------------------------------------
#UPLOAD_DIR=./var/uploads
#MAX_UPLOAD_BYTES=15728640

# How many reverse proxies sit in front of this process. cPanel puts one there,
# so 1 is right for that deployment. Getting this wrong makes every request look
# like it came from 127.0.0.1, and the per-IP rate limiter then throttles the
# whole world as a single caller.
#TRUST_PROXY=1
